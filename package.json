    "next": "15.5.5",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.68.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@it-incubator/eslint-config": "^1.0.4",
